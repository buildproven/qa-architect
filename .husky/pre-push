#!/bin/sh
set -eu

repo_variables=$(git rev-parse --local-env-vars)
for variable in $repo_variables; do
  unset "$variable"
done

updates=""
if [ ! -t 0 ]; then
  updates=$(cat)
fi
if [ -n "$updates" ] && printf '%s\n' "$updates" | awk '
  NF { saw = 1; if ($2 !~ /^0+$/) non_deletion = 1 }
  END { exit !(saw && !non_deletion) }
'; then
  echo "Pre-push: remote branch deletion only."
  exit 0
fi

echo "Pre-push: lint."
npm run lint --silent

if command -v gitleaks >/dev/null 2>&1; then
  echo "Pre-push: secret scan."
  gitleaks detect --no-git --redact --no-banner --exit-code=1
else
  echo "Pre-push: gitleaks is absent. Required CI secret scan remains authoritative."
fi

base_ref=""
if git rev-parse --verify --quiet '@{upstream}' >/dev/null; then
  base_ref='@{upstream}'
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  base_ref='origin/main'
fi

dependency_changed=true
if [ -n "$base_ref" ]; then
  base_sha=$(git merge-base "$base_ref" HEAD)
  if git diff --quiet "$base_sha...HEAD" -- \
    package.json package-lock.json npm-shrinkwrap.json \
    pnpm-lock.yaml yarn.lock bun.lock bun.lockb; then
    dependency_changed=false
  fi
fi

if [ "$dependency_changed" = true ]; then
  echo "Pre-push: dependency audit."
  if [ -f pnpm-lock.yaml ]; then
    pnpm audit --audit-level high --prod
  elif [ -f yarn.lock ]; then
    yarn audit --level high --groups dependencies
  elif [ -f bun.lock ] || [ -f bun.lockb ]; then
    bun audit --audit-level high
  else
    npm audit --audit-level=high --omit=dev
  fi
else
  echo "Pre-push: dependency files did not change."
fi

echo "Pre-push passed. CI runs the revision-bound security and test gates."
