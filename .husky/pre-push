#!/bin/bash
set -euo pipefail

# Git hooks can export repository-local variables. Do not pass them to tools
# that create or inspect a different repository.
while IFS= read -r variable; do
  unset "$variable"
done < <(git rev-parse --local-env-vars)

updates=""
if [ ! -t 0 ]; then
  updates=$(cat)
fi
if [ -n "$updates" ] && printf '%s\n' "$updates" | awk '
  NF { saw = 1; if ($2 !~ /^0+$/) non_deletion = 1 }
  END { exit !(saw && !non_deletion) }
'; then
  echo "Pre-push: remote branch deletion only."
  exit 0
fi

base_ref=""
if git rev-parse --verify --quiet '@{upstream}' >/dev/null; then
  base_ref='@{upstream}'
elif git rev-parse --verify --quiet origin/main >/dev/null; then
  base_ref='origin/main'
else
  echo "Pre-push: no base ref. CI will select affected tests."
  exit 0
fi

base_sha=$(git merge-base "$base_ref" HEAD)
if git diff --quiet "$base_sha...HEAD" -- package.json package-lock.json; then
  echo "Pre-push: no dependency audit needed. CI will select affected tests."
  exit 0
fi

echo "Pre-push: dependency files changed. Running the production audit."
npm audit --audit-level=high --omit=dev
