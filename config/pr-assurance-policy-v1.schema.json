{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/buildproven/qa-architect/blob/main/config/pr-assurance-policy-v1.schema.json",
  "title": "QA Architect PR assurance execution policy v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engine": { "const": "semgrep" },
    "required": { "const": true },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "pathExcludes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
      }
    }
  }
}
