{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/buildproven/qa-architect/blob/main/config/ship-assurance-manifest-v1.schema.json",
  "title": "QA Architect ship assurance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "evidenceIdentity",
    "revision",
    "branch",
    "commit",
    "workflowTier",
    "risk",
    "stack",
    "policy",
    "inputs",
    "rulePackVersion",
    "preview",
    "requiredChecks",
    "waivers",
    "results",
    "references",
    "tools",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "verdict": { "enum": ["PASS", "BLOCK", "INCOMPLETE"] },
    "evidenceIdentity": { "$ref": "#/$defs/sha256" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "baseRef", "head", "diffSha256"],
      "properties": {
        "base": { "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "baseRef": { "type": ["string", "null"] },
        "head": { "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
        "diffSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "branch": { "type": ["string", "null"] },
    "commit": { "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
    "workflowTier": { "enum": ["minimal", "standard", "comprehensive"] },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "changedFiles"],
      "properties": {
        "tier": { "enum": ["low", "medium", "high", "critical", "unknown"] },
        "changedFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "enum": [
          "node",
          "nextjs",
          "typescript",
          "prisma",
          "drizzle",
          "stripe",
          "supabase",
          "python"
        ]
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "rulePackVersion": { "type": "string", "minLength": 1 },
    "preview": {
      "anyOf": [{ "$ref": "#/$defs/preview" }, { "type": "null" }]
    },
    "requiredChecks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "waivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policySha256", "fingerprints", "error"],
      "properties": {
        "policySha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "fingerprints": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "error": { "type": ["string", "null"] }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "git", "gitleaks", "semgrep"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": ["string", "null"] },
        "git": { "type": ["string", "null"] },
        "gitleaks": { "type": ["string", "null"] },
        "semgrep": { "type": ["string", "null"] }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkVersion",
        "status",
        "target",
        "environment",
        "configSha256",
        "checks",
        "evaluatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "checkVersion": { "const": "1.0.0" },
        "status": { "enum": ["pass", "fail", "incomplete"] },
        "target": { "type": ["string", "null"] },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "revisionBinding"],
          "properties": {
            "classification": {
              "enum": ["preview", "production", "unknown"]
            },
            "revisionBinding": { "enum": ["verified", "unverified"] },
            "deploymentIdSha256": {
              "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            }
          }
        },
        "configSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/previewCheck" }
        },
        "evaluatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "previewCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "summary", "observations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": "1.0.0" },
        "status": { "enum": ["pass", "fail", "incomplete"] },
        "summary": { "type": "string" },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/previewObservation" }
        },
        "cleanup": { "enum": ["not-attempted", "complete", "failed"] },
        "fixtureIdSha256": { "$ref": "#/$defs/sha256" },
        "resourceIdSha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "previewObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response", "startedAt", "durationMs"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "origin", "path", "queryKeys"],
          "properties": {
            "method": { "type": "string" },
            "origin": { "type": "string" },
            "path": { "type": "string" },
            "queryKeys": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "response": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "headerNames",
                "bodySha256",
                "bodyBytes",
                "truncated"
              ],
              "properties": {
                "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                "headerNames": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "bodySha256": { "$ref": "#/$defs/sha256" },
                "bodyBytes": { "type": "integer", "minimum": 0 },
                "truncated": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "timeoutMs"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "required", "status", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": { "enum": ["pass", "warn", "fail", "skip", "incomplete"] },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "command": { "$ref": "#/$defs/command" },
        "exitCode": { "type": ["integer", "null"] },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "sha256",
        "revision",
        "verdict",
        "findingFingerprints",
        "rulePackVersion",
        "fresh"
      ],
      "properties": {
        "type": { "enum": ["pr-assurance", "remediation", "unknown"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "revision": {
          "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }]
        },
        "verdict": { "type": ["string", "null"] },
        "findingFingerprints": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "rulePackVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "fresh": { "type": "boolean" }
      }
    }
  }
}
